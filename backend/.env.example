# Server Configuration
PORT=5000
NODE_ENV=development

# Blockchain Configuration
INFURA_PROJECT_ID=your_infura_project_id_here
ETHEREUM_NETWORK=sepolia
PRIVATE_KEY=your_private_key_here_optional

# API Configuration
CORS_ORIGIN=http://localhost:5173

# IPFS Configuration (Infura IPFS)
INFURA_IPFS_PROJECT_ID=your_ipfs_project_id_here
INFURA_IPFS_SECRET=your_ipfs_secret_here

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Crypto On-Ramps
MOONPAY_API_KEY=your_moonpay_api_key_here
TRANSAK_API_KEY=your_transak_api_key_here

# Etherscan API (optional, for transaction verification)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
